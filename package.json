{
  "name": "authright-voting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate && node scripts/dev.mjs",
    "dev:prewarm": "node scripts/dev.mjs --warmup-only",
    "build": "next build --webpack",
    "start": "next start",
    "check": "tsc --noEmit && eslint .",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:migrate": "node --import tsx scripts/migrate.ts",
    "db:backup": "node --import tsx scripts/backup.ts",
    "admin:init": "node --import tsx scripts/admin.ts init",
    "admin:reset-password": "node --import tsx scripts/admin.ts reset"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "next": "16.3.6",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "26.6.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
